{
  "name": "youlink",
  "version": "0.0.0",
  "private": true,
  "description": "YouLink — a lite, motion-first personal social network for showcasing a portfolio. See BLUEPRINT.md.",
  "license": "UNLICENSED",
  "author": "Hanson Uko <hansonuko@gmail.com>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/supabase-js": "^2.45.0",
    "@supabase/ssr": "^0.5.0",
    "@radix-ui/react-slot": "^1.1.0",
    "framer-motion": "^11.11.0",
    "zustand": "^5.0.0",
    "zod": "^3.23.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "resend": "^4.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.451.0",
    "next-themes": "^0.4.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "@netlify/plugin-nextjs": "^5.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
