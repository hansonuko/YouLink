# ──────────────────────────────────────────────────────────────
# YouLink — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=YouLink
NEXT_PUBLIC_OWNER_USERNAME=your-username

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# For local schema pushes / supabase CLI
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Auth
# Random 32+ char secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# OAuth (optional, Phase 1) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="YouLink <hello@yourdomain.com>"

# Rate limiting — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot protection — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Observability (optional, Phase 6)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Feature flags (default off until the corresponding phase lands)
NEXT_PUBLIC_FEATURE_CHAT=false
NEXT_PUBLIC_FEATURE_EMAIL_DIGEST=false
